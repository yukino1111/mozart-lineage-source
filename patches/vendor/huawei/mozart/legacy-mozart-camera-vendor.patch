+MOZART_VENDOR_PATH := vendor/huawei/mozart/proprietary
+
+PRODUCT_COPY_FILES += \
+    $(MOZART_VENDOR_PATH)/isp/isp.bin:$(TARGET_COPY_OUT_SYSTEM)/isp/isp.bin \
+    $(MOZART_VENDOR_PATH)/system/lib/imedia_filters.so:$(TARGET_COPY_OUT_SYSTEM)/lib/imedia_filters.so \
+    $(MOZART_VENDOR_PATH)/system/lib/libSmartAE.so:$(TARGET_COPY_OUT_SYSTEM)/lib/libSmartAE.so \
+    $(MOZART_VENDOR_PATH)/system/lib/libcamera_ae.so:$(TARGET_COPY_OUT_SYSTEM)/lib/libcamera_ae.so \
+    $(MOZART_VENDOR_PATH)/system/lib/libcamera_af.so:$(TARGET_COPY_OUT_SYSTEM)/lib/libcamera_af.so \
