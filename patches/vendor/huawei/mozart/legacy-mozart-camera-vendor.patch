+    $(MOZART_VENDOR_PATH)/system/lib/libcamera_flash.so:$(TARGET_COPY_OUT_SYSTEM)/lib/libcamera_flash.so \
+    $(MOZART_VENDOR_PATH)/vendor/bin/HwCamCfgSvr:$(TARGET_COPY_OUT_VENDOR)/bin/HwCamCfgSvr \
+    $(MOZART_VENDOR_PATH)/vendor/lib/hw/camera.hi3635.so:$(TARGET_COPY_OUT_VENDOR)/lib/hw/camera.hi3635.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libHWCamCfgSvr.so:$(TARGET_COPY_OUT_VENDOR)/lib/libHWCamCfgSvr.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libexif.so:$(TARGET_COPY_OUT_VENDOR)/lib/libexif_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libexpat_mozart.so:$(TARGET_COPY_OUT_VENDOR)/lib/libexpat_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libft2_mozart.so:$(TARGET_COPY_OUT_VENDOR)/lib/libft2_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libicui18n_mozart.so:$(TARGET_COPY_OUT_VENDOR)/lib/libicui18n_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libicuuc_mozart.so:$(TARGET_COPY_OUT_VENDOR)/lib/libicuuc_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libjpeg.so:$(TARGET_COPY_OUT_VENDOR)/lib/libjpeg_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libjpegenchw.so:$(TARGET_COPY_OUT_VENDOR)/lib/libjpegenchw.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libjpu.so:$(TARGET_COPY_OUT_VENDOR)/lib/libjpu.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libmemtrack.so:$(TARGET_COPY_OUT_VENDOR)/lib/libmemtrack_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libpng_mozart.so:$(TARGET_COPY_OUT_VENDOR)/lib/libpng_mozart.so \
+    $(MOZART_VENDOR_PATH)/vendor/lib/libskia.so:$(TARGET_COPY_OUT_VENDOR)/lib/libskia_mozart.so
+
+PRODUCT_COPY_FILES += $(call find-copy-subdir-files,*,$(MOZART_VENDOR_PATH)/etc/camera,$(TARGET_COPY_OUT_SYSTEM)/etc/camera)
+PRODUCT_COPY_FILES += $(call find-copy-subdir-files,*,$(MOZART_VENDOR_PATH)/system/lib/hwcam,$(TARGET_COPY_OUT_SYSTEM)/lib/hwcam)
