+static void deriveHuaweiLegacyStreamConfigurations(
+        CameraMetadata &chars, Vector<int32_t> *derivedCharKeys) {
+    camera_metadata_entry streamConfigs =
+            chars.find(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS);
+    camera_metadata_entry formats = chars.find(ANDROID_SCALER_AVAILABLE_FORMATS);
+    camera_metadata_entry processedSizes =
+            chars.find(ANDROID_SCALER_AVAILABLE_PROCESSED_SIZES);
+    camera_metadata_entry jpegSizes = chars.find(ANDROID_SCALER_AVAILABLE_JPEG_SIZES);
+    camera_metadata_entry rawSizes = chars.find(ANDROID_SCALER_AVAILABLE_RAW_SIZES);
+    if (streamConfigs.count != 0 || formats.count == 0 || processedSizes.count == 0) {
+        return;
+    }
+
+    Vector<int32_t> configurations;
+    Vector<int64_t> minDurations;
+    Vector<int64_t> stallDurations;
+    constexpr int64_t kFrameDurationNs = 33333333LL;
+    constexpr int64_t kJpegStallNs = 100000000LL;
+    auto appendSizes = [&](int32_t format, const camera_metadata_entry &sizes) {
+        for (size_t i = 0; i + 1 < sizes.count; i += 2) {
+            const int32_t width = sizes.data.i32[i];
+            const int32_t height = sizes.data.i32[i + 1];
+            configurations.push(format); configurations.push(width);
+            configurations.push(height);
+            configurations.push(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS_OUTPUT);
+            minDurations.push(format); minDurations.push(width);
+            minDurations.push(height); minDurations.push(kFrameDurationNs);
+            stallDurations.push(format); stallDurations.push(width);
+            stallDurations.push(height);
+            stallDurations.push(format == HAL_PIXEL_FORMAT_BLOB ? kJpegStallNs : 0);
+        }
+    };
+    for (size_t i = 0; i < formats.count; ++i) {
+        const int32_t format = formats.data.i32[i];
+        if (format == HAL_PIXEL_FORMAT_BLOB) {
+            appendSizes(format, jpegSizes);
+        } else if (format == HAL_PIXEL_FORMAT_RAW16 ||
+                format == HAL_PIXEL_FORMAT_RAW10 ||
+                format == HAL_PIXEL_FORMAT_RAW12 ||
+                format == HAL_PIXEL_FORMAT_RAW_OPAQUE) {
+            appendSizes(format, rawSizes);
+        } else {
+            appendSizes(format, processedSizes);
+        }
+    }
+    chars.update(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS, configurations);
+    chars.update(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS, minDurations);
+    chars.update(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS, stallDurations);
+    derivedCharKeys->push(ANDROID_SCALER_AVAILABLE_STREAM_CONFIGURATIONS);
+    derivedCharKeys->push(ANDROID_SCALER_AVAILABLE_MIN_FRAME_DURATIONS);
+    derivedCharKeys->push(ANDROID_SCALER_AVAILABLE_STALL_DURATIONS);
+
+    auto expandArrayRect = [&](uint32_t tag) {
+        camera_metadata_entry entry = chars.find(tag);
+        if (entry.count == 2) {
+            int32_t rect[4] = {0, 0, entry.data.i32[0], entry.data.i32[1]};
+            chars.update(tag, rect, 4);
+            derivedCharKeys->push(tag);
+        }
+    };
+    expandArrayRect(ANDROID_SENSOR_INFO_ACTIVE_ARRAY_SIZE);
+    expandArrayRect(ANDROID_SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE);
+
+    uint8_t byteValue = ANDROID_INFO_SUPPORTED_HARDWARE_LEVEL_LEGACY;
+    chars.update(ANDROID_INFO_SUPPORTED_HARDWARE_LEVEL, &byteValue, 1);
+    derivedCharKeys->push(ANDROID_INFO_SUPPORTED_HARDWARE_LEVEL);
+    byteValue = ANDROID_SENSOR_INFO_TIMESTAMP_SOURCE_UNKNOWN;
+    chars.update(ANDROID_SENSOR_INFO_TIMESTAMP_SOURCE, &byteValue, 1);
+    derivedCharKeys->push(ANDROID_SENSOR_INFO_TIMESTAMP_SOURCE);
+    byteValue = ANDROID_SCALER_CROPPING_TYPE_CENTER_ONLY;
+    chars.update(ANDROID_SCALER_CROPPING_TYPE, &byteValue, 1);
+    derivedCharKeys->push(ANDROID_SCALER_CROPPING_TYPE);
+    int32_t outputStreams[3] = {1, 3, 1};
+    chars.update(ANDROID_REQUEST_MAX_NUM_OUTPUT_STREAMS, outputStreams, 3);
+    derivedCharKeys->push(ANDROID_REQUEST_MAX_NUM_OUTPUT_STREAMS);
+    int32_t value = 0;
+    chars.update(ANDROID_REQUEST_MAX_NUM_INPUT_STREAMS, &value, 1);
+    derivedCharKeys->push(ANDROID_REQUEST_MAX_NUM_INPUT_STREAMS);
+    value = 1;
+    chars.update(ANDROID_REQUEST_PARTIAL_RESULT_COUNT, &value, 1);
+    derivedCharKeys->push(ANDROID_REQUEST_PARTIAL_RESULT_COUNT);
+    value = ANDROID_SYNC_MAX_LATENCY_UNKNOWN;
+    chars.update(ANDROID_SYNC_MAX_LATENCY, &value, 1);
+    derivedCharKeys->push(ANDROID_SYNC_MAX_LATENCY);
+    byteValue = 4;
+    chars.update(ANDROID_REQUEST_PIPELINE_MAX_DEPTH, &byteValue, 1);
+    derivedCharKeys->push(ANDROID_REQUEST_PIPELINE_MAX_DEPTH);
+}
