+Status CameraDeviceSession::registerLegacyBuffers(const CaptureRequest& request) {
+    if (mDeviceVersion > CAMERA_DEVICE_API_VERSION_3_1) {
+        return Status::OK;
+    }
+    if (mDevice->ops->register_stream_buffers == nullptr) {
+        ALOGE("%s: HAL version 0x%x has no register_stream_buffers operation",
+                __FUNCTION__, mDeviceVersion);
+        return Status::INTERNAL_ERROR;
+    }
+
+    Mutex::Autolock _l(mInflightLock);
+
+    std::set<int> requestStreamIds;
+    for (const auto& buffer : request.outputBuffers) {
+        requestStreamIds.insert(buffer.streamId);
+    }
+    if (request.inputBuffer.streamId != -1 && request.inputBuffer.bufferId != 0) {
+        requestStreamIds.insert(request.inputBuffer.streamId);
+    }
+
+    for (int streamId : requestStreamIds) {
+        if (mLegacyRegisteredStreams.count(streamId) != 0) {
+            continue;
+        }
+
+        auto streamIt = mStreamMap.find(streamId);
+        auto buffersIt = mCirculatingBuffers.find(streamId);
+        if (streamIt == mStreamMap.end() || buffersIt == mCirculatingBuffers.end() ||
+                buffersIt->second.empty()) {
+            ALOGE("%s: no configured stream or imported buffer for stream %d",
+                    __FUNCTION__, streamId);
+            return Status::INTERNAL_ERROR;
+        }
+
+        std::vector<buffer_handle_t*> buffers;
+        buffers.reserve(buffersIt->second.size());
+        for (auto& entry : buffersIt->second) {
+            buffers.push_back(&entry.second);
+        }
+
+        camera3_stream_buffer_set_t bufferSet = {
+                &streamIt->second,
+                static_cast<uint32_t>(buffers.size()),
+                buffers.data(),
+        };
+        status_t ret = mDevice->ops->register_stream_buffers(mDevice, &bufferSet);
+        if (ret != OK) {
+            ALOGE("%s: register_stream_buffers failed for stream %d: %s (%d)",
+                    __FUNCTION__, streamId, strerror(-ret), ret);
+            return Status::INTERNAL_ERROR;
+        }
+
+        mLegacyRegisteredStreams.insert(streamId);
+        ALOGI("%s: registered %zu initial buffer(s) for legacy HAL stream %d",
+                __FUNCTION__, buffers.size(), streamId);
+    }
+
+    return Status::OK;
+}
