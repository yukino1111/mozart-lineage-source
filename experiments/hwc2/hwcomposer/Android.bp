cc_library_shared {
    name: "hwcomposer.hi3635",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "both",

    srcs: ["MozartHwc2.cpp"],

    header_libs: ["libhardware_headers"],
    shared_libs: [
        "libhardware",
        "libhwc2onfbadapter",
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
