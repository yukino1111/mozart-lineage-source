allow kernel self:global_capability_class_set mknod;
allow kernel device:dir { write add_name remove_name };
allow kernel block_device:dir { getattr search };
allow kernel device:chr_file { create getattr setattr unlink };
allow kernel device:blk_file { create getattr setattr unlink };
allow kernel mozart_dfx_block_device:blk_file rw_file_perms;
allow kernel mozart_hwlog_device:chr_file { open write };
allow kernel mozart_memorydump_data_file:dir create_dir_perms;
allow kernel mozart_memorydump_data_file:file create_file_perms;
allow kernel mozart_sysfs_devfreq:file rw_file_perms;
allow kernel sysfs_devices_system_cpu:file w_file_perms;

# The 3.10 kernel requests userspace module loading for built-in filesystems
# and 32-bit ELF personalities. Android has no module loader for these probes.
dontaudit domain kernel:system module_request;
