# /sbin lives on rootfs during early boot; teecd uses the platform tee domain
# and starts before the ramdisk executable can be relabeled to tee_exec.
allow tee rootfs:file { getattr open read execute map entrypoint };

allow tee properties_device:dir r_dir_perms;

type mozart_trustedcore_prop, property_type;
set_prop(tee, mozart_trustedcore_prop)

# The stock daemon probes an obsolete atrace debug property at startup.
dontaudit tee debug_prop:property_service set;
