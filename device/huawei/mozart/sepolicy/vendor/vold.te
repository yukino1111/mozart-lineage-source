# The legacy 3.10 crypto API requests the selected AES driver while
# constructing the dm-crypt CBC/GIV transform, even when it is built-in.
allow vold kernel:system module_request;

# This non-A/B device has no boot-control HAL. Vold probes it opportunistically
# before falling back to the legacy single-slot path.
dontaudit vold hal_bootctl_hwservice:hwservice_manager find;
