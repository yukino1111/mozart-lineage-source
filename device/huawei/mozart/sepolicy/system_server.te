allow system_server sensors_device:chr_file rw_file_perms;
allow system_server mozart_gps_data_file:dir rw_dir_perms;
allow system_server mozart_gps_data_file:fifo_file create_file_perms;
unix_socket_connect(system_server, mozart_gps, gpsd)
allow system_server mozart_sensors_data_file:file { rw_file_perms setattr };

# These framework properties are omitted from the legacy non-compatible
# property policy generated for this pre-Treble device.
get_prop(system_server, exported_camera_prop)
get_prop(system_server, userspace_reboot_config_prop)
get_prop(system_server, userspace_reboot_exported_prop)
